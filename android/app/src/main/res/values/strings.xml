<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Detoxo</string>
    <string name="accessibility_service_description">Detoxo uses the Accessibility Service to detect short-form video (reels, shorts) in your apps and block it so you can stay focused. It reads on-screen content only to find and block distracting feeds; it does not collect or transmit your screen content.</string>
    <string name="accessibility_service_summary">Detect and block reels, shorts and infinite feeds.</string>
    <!-- Shown in Android's "Notification access" list. Says what the grant is
         used for, since that system screen offers no other explanation. -->
    <string name="notification_listener_label">Detoxo Notification Silence</string>
    <string name="device_admin_label">Detoxo Uninstall Protection</string>
    <string name="device_admin_description">Prevents the app from being removed while protection is active.</string>
    <string name="cc_widget_description">Reel counter</string>

    <!-- Engine surfaces (toasts + notifications). One shared block toast so the
         web and whole-app copy can never drift apart again. -->
    <string name="toast_blocked">%1$s is blocked by Detoxo</string>
    <!-- EVO-018: adult-list (18+) hits are never named on screen. -->
    <string name="toast_blocked_adult">Adult site blocked by Detoxo</string>

    <!-- The block screen (intervention wall). The headline reuses the two
         toast strings above so wall and toast copy can never drift. Plan
         labels are NOT resources: `planLabel()` in BlockScreenRenderer.kt is
         a pure function so a JVM test can pin the legacy Conscious wire token
         to its "Conscious" label. -->
    <!-- The soft nudge card. Advisory, never accusatory: it states the elapsed
         time and asks a question, because the user opted into being told, not
         into being told off.

         The body asserts NOTHING about what the user is doing. The dwell
         machine measures time in the app and walks no nodes (see
         NudgeTracker), so it cannot know whether they are scrolling, reading a
         DM or on a call — and telling a user on a video call that they are
         "still scrolling" spends the trust the honest-numbers pitch earns.
         The title carries the one fact the engine actually has. -->
    <string name="nudge_title">%1$s · %2$d min</string>
    <string name="nudge_body">Good time to put it down?</string>
    <string name="nudge_dismiss">Dismiss</string>
    <!-- The card's single action: the user leaves, on their own tap. The
         engine still never blocks for a nudge. -->
    <string name="nudge_leave">Leave</string>
    <!-- Whole-card label for TalkBack; activating the card dismisses it. -->
    <string name="nudge_card_a11y">%1$s for %2$d minutes. Tap to dismiss.</string>

